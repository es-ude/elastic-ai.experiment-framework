{
  "version": 3,

  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host Debug Build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PLATFORM": "host"
      }
    },
    {
      "name": "pico-debug",
      "displayName": "Pico Debug Build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/pico-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PLATFORM": "pico",
        "PICO_PLATFORM": "rp2040",
        "CMAKE_TOOLCHAIN_FILE": "$env{PICO_SDK_PATH}/cmake/preload/toolchains/pico_arm_cortex_m0plus_gcc.cmake"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "pico-debug",
      "configurePreset": "pico-debug"
    }
  ],

  "testPresets": [
    {
      "name": "host-unit",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}