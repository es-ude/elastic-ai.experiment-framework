{
  "version": 3,
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host Debug Build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PLATFORM": "host"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    }
    
  ],

  "testPresets": [
    {
      "name": "host-unit",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      }
    }

  ]
}