{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Build everything",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "debug"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "system_test",
      "inherits": "debug",
      "configurePreset": "debug"
    }
    
  ],

  "testPresets": [
    {
      "name": "system_test",
      "displayName": "System Tests",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit"
        }
      }
    }

  ]
}